# Copy to .env, or just start the app: it asks for your API key on first launch and writes this file for you.
# 复制为 .env，或者直接启动程序：首次打开时会弹窗让你填写 API key 并自动写入这个文件。

# DarkerDB v2 API key with the darkerdb.live and darkerdb.data scopes
# https://darkerdb.com/dashboard/api-keys
DARKER_MARKET_API_KEY=

# Optional Postgres. Leave DB_USER empty to store data as CSV files in ./data (recommended for most users).
# 可选的 Postgres。DB_USER 留空则数据以 CSV 存在 ./data 目录（大多数人用这个就够了）。
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=darkerdb
DB_USER=
DB_PASSWORD=

# Web server. HOST=0.0.0.0 exposes the app to your local network; only do that on a trusted network.
# HOST=127.0.0.1
# PORT=5001
